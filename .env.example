OLLAMA_MODEL=gemma3
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=chroma_db
CHROMA_COLLECTION=research_papers_v3
UPLOAD_DIR=uploads
# Local development can use SQLite. For PostgreSQL set DATABASE_URL, e.g.
# postgresql+psycopg://postgres:password@localhost:5432/research_assistant
DATABASE_URL=sqlite:///./research_assistant.db
TOP_K=5
MAX_FILE_SIZE_MB=25
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
